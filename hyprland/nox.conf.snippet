# NoX Hyprland autostart snippet
#
# Add this line to your ~/.config/hypr/hyprland.conf:
#
#   exec-once = ~/nox/scripts/nx-open.sh
#
# DO NOT add it automatically — edit hyprland.conf yourself.
#
# Order at login: FaceLock → noxd (via systemd) → nx-open.sh → Chromium

exec-once = ~/nox/scripts/nx-open.sh
