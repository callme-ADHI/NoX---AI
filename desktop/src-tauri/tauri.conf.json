{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoX",
  "version": "0.1.0",
  "identifier": "ai.nox.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoX",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#05060F",
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:7777 ws://127.0.0.1:7777; img-src 'self' http://127.0.0.1:7777 data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' http://127.0.0.1:7777;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

