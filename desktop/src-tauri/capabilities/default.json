{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-check-daemon-health",
    "allow-get-session-token",
    "allow-open-in-browser",
    "allow-start-daemon"
  ]
}
